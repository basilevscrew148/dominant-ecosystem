{
  "name": "@local/dominant",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Holds the current dominant (Ukhtomsky) as a persistent goal, chronotope target and parking list, exposed as the `dominant` tool, an HTTP page, and a client badge.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
